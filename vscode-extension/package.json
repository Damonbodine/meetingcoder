{
    "name": "meetingcoder-vscode",
    "displayName": "MeetingCoder Assistant",
    "description": "Connects VS Code to MeetingCoder for live agentic assistance",
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "meetingcoder.connect",
                "title": "MeetingCoder: Connect"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./"
    },
    "devDependencies": {
        "@types/vscode": "^1.85.0",
        "@types/node": "18.x",
        "typescript": "^5.3.3"
    },
    "dependencies": {
        "ws": "^8.16.0"
    }
}